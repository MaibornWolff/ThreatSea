{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "deploymentAnnotations": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "origin": {
          "type": "string"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "allowHttp": {
              "type": "boolean"
            }
          }
        },
        "cookies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secure": {
              "type": "boolean"
            }
          }
        },
        "useProxy": {
          "type": "boolean"
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jwtSecret": {
              "type": "string"
            },
            "sessionSecret": {
              "type": "string"
            },
            "oidcClientSecret": {
              "type": "string"
            },
            "databasePassword": {
              "type": "string"
            }
          }
        },
        "configKeys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oidcIssuerUrl": {
              "type": "string"
            },
            "oidcClientId": {
              "type": "string"
            },
            "databaseHost": {
              "type": "string"
            },
            "databaseName": {
              "type": "string"
            },
            "databaseUser": {
              "type": "string"
            }
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jwtSecret": {
              "type": "string"
            },
            "sessionSecret": {
              "type": "string"
            },
            "oidcClientSecret": {
              "type": "string"
            },
            "databasePassword": {
              "type": "string"
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "tls": {
          "type": "string",
          "enum": ["verify", "no-verify", "disabled"]
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k)?$"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayName": {
          "type": "string"
        },
        "gatewayNamespace": {
          "type": "string"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sectionName": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "strategy": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    }
  }
}
